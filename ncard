#!/usr/bin/env node
/**
 * ncard — CLI quirúrgico para operar cards de Notion vía API REST oficial.
 * Construido sobre @notionhq/client (SDK oficial). Nunca MCP.
 *
 * Subcomandos:
 *   ncard get <page_id>                 # JSON: título + propiedades + contenido aplanado
 *   ncard move <page_id> <status>       # PATCH de Status (validado contra las 5 opciones)
 *   ncard comment <page_id> "texto" | -      # - = markdown por stdin (negrita, código) | -      # - = markdown por stdin (negrita, código)
 *   ncard append <page_id> <file.md|->
 *   ncard subpage <page_id> "<título>" <file.md|->
 *   ncard whoami                        # bot user id (lo usa el anti-loop del server)
 */
import { Client } from '@notionhq/client'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { mdToBlocks, inline } from './src/md-blocks.ts'

const BRIDGE_DIR = path.dirname(fileURLToPath(import.meta.url))

// ---- .env ----
function loadEnv() {
  const envPath = path.join(BRIDGE_DIR, '.env')
  if (!fs.existsSync(envPath)) return
  for (const line of fs.readFileSync(envPath, 'utf8').split('\n')) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/)
    if (!m) continue
    let [, key, val] = m
    val = val.replace(/^["']|["']$/g, '')
    if (!(key in process.env)) process.env[key] = val
  }
}
loadEnv()

// estados y nombres de propiedad desde config/workflow.json del bridge. Sin

// workflow, ncard funciona igual pero sin validar estados y con nombres default.
function readWorkflow() {
  for (const p of [path.join(BRIDGE_DIR, 'config', 'workflow.json')]) {
    try {
      const wf = JSON.parse(fs.readFileSync(p, 'utf8'))
      return { states: wf.states.map(s => s.name), prop: wf.status_property ?? 'Status', repoProp: wf.repo_property ?? 'Repo' }
    } catch { /* siguiente candidato */ }
  }
  return { states: null, prop: 'Status', repoProp: 'Repo' }
}
const WF = readWorkflow()
const STATUS_OPTIONS = WF.states
const STATUS_PROP = WF.prop
const REPO_PROP = WF.repoProp

function die(msg, code = 1) {
  process.stderr.write(`ncard: ${msg}\n`)
  process.exit(code)
}

if (!process.env.NOTION_TOKEN) die('falta NOTION_TOKEN (defínelo en .env junto a este script)')

const notion = new Client({ auth: process.env.NOTION_TOKEN })

// ---- retry 429 (máx 3 reintentos, respeta Retry-After) ----
function retryAfterSeconds(err) {
  const h = err?.headers
  let v
  if (h && typeof h.get === 'function') v = h.get('retry-after')
  else if (h) v = h['retry-after'] ?? h['Retry-After']
  const n = Number(v)
  return Number.isFinite(n) && n > 0 ? n : null
}

async function withRetry(fn) {
  let lastErr
  for (let attempt = 0; attempt <= 3; attempt++) {
    try {
      return await fn()
    } catch (err) {
      lastErr = err
      if (err?.status !== 429 || attempt === 3) throw err
      const wait = retryAfterSeconds(err) ?? 2 ** attempt
      process.stderr.write(`ncard: 429 rate limited, reintentando en ${wait}s (intento ${attempt + 1}/3)\n`)
      await new Promise(r => setTimeout(r, wait * 1000))
    }
  }
  throw lastErr
}

// ---- helpers de lectura ----
const plain = rt => (rt ?? []).map(t => t.plain_text ?? '').join('')

function propValue(prop) {
  switch (prop.type) {
    case 'title': return plain(prop.title)
    case 'rich_text': return plain(prop.rich_text)
    case 'select': return prop.select?.name ?? null
    case 'multi_select': return prop.multi_select.map(o => o.name)
    case 'status': return prop.status?.name ?? null
    case 'url': return prop.url
    case 'email': return prop.email
    case 'phone_number': return prop.phone_number
    case 'number': return prop.number
    case 'checkbox': return prop.checkbox
    case 'date': return prop.date?.start ?? null
    case 'people': return prop.people.map(p => p.name ?? p.id)
    case 'relation': return prop.relation.map(r => r.id)
    case 'created_time': return prop.created_time
    case 'last_edited_time': return prop.last_edited_time
    default: return null
  }
}

function renderBlock(block, indent) {
  const pad = '  '.repeat(indent)
  const t = block.type
  const data = block[t] ?? {}
  const text = plain(data.rich_text)
  switch (t) {
    case 'paragraph': return text ? pad + text : null
    case 'heading_1': return `${pad}# ${text}`
    case 'heading_2': return `${pad}## ${text}`
    case 'heading_3': return `${pad}### ${text}`
    case 'bulleted_list_item': return `${pad}- ${text}`
    case 'numbered_list_item': return `${pad}1. ${text}`
    case 'to_do': return `${pad}- [${data.checked ? 'x' : ' '}] ${text}`
    case 'code': return `${pad}\`\`\`${data.language ?? ''}\n${text}\n${pad}\`\`\``
    case 'quote': return `${pad}> ${text}`
    case 'callout': return `${pad}> ${text}`
    case 'toggle': return `${pad}▸ ${text}`
    case 'divider': return `${pad}---`
    case 'child_page': return `${pad}[subpágina: ${data.title ?? ''}]`
    case 'image': case 'file': case 'bookmark': case 'embed':
      return `${pad}[${t}: ${data?.external?.url ?? data?.file?.url ?? data?.url ?? ''}]`
    default: return text ? `${pad}${text}` : `${pad}[${t}]`
  }
}

async function listChildren(blockId) {
  const blocks = []
  let cursor
  do {
    const res = await withRetry(() => notion.blocks.children.list({
      block_id: blockId, page_size: 100, start_cursor: cursor,
    }))
    blocks.push(...res.results)
    cursor = res.has_more ? res.next_cursor : undefined
  } while (cursor)
  return blocks
}

async function flattenContent(blockId, indent = 0, depth = 0, visited = []) {
  if (depth > 3) return []
  const lines = []
  for (const block of await listChildren(blockId)) {
    const line = renderBlock(block, indent)
    if (line !== null) lines.push(line)
    visited.push({ id: block.id, text: (line ?? `[${block.type}]`).trim().slice(0, 100) })
    if (block.has_children && block.type !== 'child_page') {
      lines.push(...await flattenContent(block.id, indent + 1, depth + 1, visited))
    }
  }
  return lines
}

// ---- markdown → bloques ----
// ---- subcomandos ----
async function cmdGet(pageId) {
  const page = await withRetry(() => notion.pages.retrieve({ page_id: pageId }))
  const props = {}
  let title = ''
  for (const [name, prop] of Object.entries(page.properties)) {
    const val = propValue(prop)
    if (prop.type === 'title') title = val
    else props[name] = val
  }
  const visited = []
  const content = (await flattenContent(pageId, 0, 0, visited)).join('\n')
  // Comentarios (solo los NO resueltos — resolver un comentario en Notion lo saca de aquí):
  //  - anchor null  → caja de Comments del card (nivel página)
  //  - anchor texto → comentario flotante anclado a ese bloque del contenido
  const comments = []
  async function collectComments(blockId, anchor) {
    let ccursor
    do {
      const res = await withRetry(() => notion.comments.list({
        block_id: blockId, page_size: 100, start_cursor: ccursor,
      }))
      for (const c of res.results) {
        comments.push({ ts: c.created_time, author_id: c.created_by?.id ?? null, anchor, text: plain(c.rich_text) })
      }
      ccursor = res.has_more ? res.next_cursor : undefined
    } while (ccursor)
  }
  await collectComments(pageId, null)
  // flotantes: un request por bloque, con concurrencia limitada para no chocar el rate limit
  const queue = [...visited]
  await Promise.all(Array.from({ length: 3 }, async () => {
    while (queue.length) {
      const b = queue.shift()
      await collectComments(b.id, b.text)
    }
  }))
  comments.sort((a, b) => a.ts.localeCompare(b.ts))
  const out = {
    page_id: page.id,
    url: page.url,
    title,
    status: props[STATUS_PROP] ?? null,
    repo: props[REPO_PROP] ?? null,
    // el resto del board (Proyecto, RFC, Estimación, …) viaja en `properties`:
    // nombrarlas acá las volvería a hardcodear y cada equipo tiene las suyas

    properties: props,
    comments,
    content,
  }
  process.stdout.write(JSON.stringify(out, null, 2) + '\n')
}

async function cmdMove(pageId, status) {
  if (STATUS_OPTIONS && !STATUS_OPTIONS.includes(status)) {
    die(`status inválido: "${status}". Opciones: ${STATUS_OPTIONS.map(s => `"${s}"`).join(', ')}`)
  }
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    properties: { [STATUS_PROP]: { status: { name: status } } },
  }))
  process.stdout.write(`ok: Status → ${status}\n`)
}

async function cmdComment(pageId, text, extra) {
  if (!text) die('falta el texto del comentario (o "-" para stdin)')
  if (extra.length) die(`comment: sobran ${extra.length} argumento(s) — el texto se partió (¿comillas anidadas?). Usa stdin: ncard comment <page_id> - <<'EOF' … EOF`)
  const body = (text === '-' ? fs.readFileSync(0, 'utf8') : text).trim()
  if (!body) die('comentario vacío')
  await withRetry(() => notion.comments.create({
    parent: { page_id: pageId },
    rich_text: inline(body),
  }))
  process.stdout.write('ok: comentario creado\n')
}

async function cmdAppend(pageId, file) {
  if (!file) die('falta el archivo markdown (o "-" para stdin)')
  const md = file === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(file, 'utf8')
  const blocks = mdToBlocks(md)
  if (blocks.length === 0) die('markdown vacío, nada que agregar')
  for (let i = 0; i < blocks.length; i += 100) {
    await withRetry(() => notion.blocks.children.append({
      block_id: pageId, children: blocks.slice(i, i + 100),
    }))
  }
  process.stdout.write(`ok: ${blocks.length} bloques agregados\n`)
}

/**
 * Crea (o reemplaza) una subpágina hija con el detalle técnico. El cuerpo del
 * card queda para el negocio: el equipo no técnico lo lee sin ruido, y el
 * detalle sigue a un clic. Idempotente por título: re-planificar no acumula.
 */
async function cmdSubpage(pageId, title, file) {
  if (!file) die('falta el archivo markdown (o "-" para stdin)')
  const md = file === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(file, 'utf8')
  const blocks = mdToBlocks(md)
  if (blocks.length === 0) die('markdown vacío, nada que escribir')

  // una subpágina con el mismo título se archiva: el card muestra una sola verdad
  const existing = await withRetry(() => notion.blocks.children.list({ block_id: pageId, page_size: 100 }))
  for (const b of existing.results) {
    if (b.type === 'child_page' && b.child_page?.title === title) {
      await withRetry(() => notion.blocks.update({ block_id: b.id, archived: true }))
    }
  }

  const page = await withRetry(() => notion.pages.create({
    parent: { page_id: pageId },
    properties: { title: [{ type: 'text', text: { content: title } }] },
    children: blocks.slice(0, 100),
  }))
  for (let i = 100; i < blocks.length; i += 100) {
    await withRetry(() => notion.blocks.children.append({ block_id: page.id, children: blocks.slice(i, i + 100) }))
  }
  process.stdout.write(`ok: subpágina "${title}" (${blocks.length} bloques) → ${page.url ?? page.id}\n`)
}

async function cmdSetUrl(pageId, prop, url) {
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    properties: { [prop]: { url } },
  }))
  process.stdout.write(`ok: ${prop} → ${url}\n`)
}

async function cmdSetSelect(pageId, prop, value) {
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    properties: { [prop]: { select: { name: value } } },
  }))
  process.stdout.write(`ok: ${prop} → ${value}\n`)
}

async function cmdSetNum(pageId, prop, value) {
  const n = Number(value)
  if (!Number.isFinite(n)) die(`número inválido: ${value}`)
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    properties: { [prop]: { number: n } },
  }))
  process.stdout.write(`ok: ${prop} → ${n}\n`)
}

async function cmdSetPeople(pageId, prop, userId) {
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    properties: { [prop]: { people: [{ object: 'user', id: userId }] } },
  }))
  process.stdout.write(`ok: ${prop} → ${userId}\n`)
}

async function cmdIcon(pageId, emoji) {
  await withRetry(() => notion.pages.update({
    page_id: pageId,
    icon: { type: 'emoji', emoji },
  }))
  process.stdout.write(`ok: icono → ${emoji}\n`)
}

async function cmdWhoami() {
  const me = await withRetry(() => notion.users.me({}))
  process.stdout.write(JSON.stringify({ id: me.id, name: me.name, type: me.type }, null, 2) + '\n')
}

// ---- main ----
const [cmd, ...args] = process.argv.slice(2)
const USAGE = `uso:
  ncard get <page_id>
  ncard move <page_id> <status>      # ${STATUS_OPTIONS ? STATUS_OPTIONS.join(' | ') : '(estados del workflow.json del bridge)'}
  ncard comment <page_id> "texto"
  ncard append <page_id> <file.md|->
  ncard subpage <page_id> "<título>" <file.md|->   # detalle técnico en una subpágina hija
  ncard seturl <page_id> <Propiedad> <url>
  ncard setselect <page_id> <Propiedad> <valor>
  ncard setnum <page_id> <Propiedad> <número>
  ncard setpeople <page_id> <Propiedad> <user_id>
  ncard icon <page_id> <emoji>
  ncard whoami`

try {
  switch (cmd) {
    case 'get': args[0] ? await cmdGet(args[0]) : die(USAGE); break
    case 'move': args[0] && args[1] ? await cmdMove(args[0], args[1]) : die(USAGE); break
    case 'comment': args[0] ? await cmdComment(args[0], args[1], args.slice(2)) : die(USAGE); break
    case 'append': args[0] ? await cmdAppend(args[0], args[1]) : die(USAGE); break
    case 'subpage': args[0] && args[1] ? await cmdSubpage(args[0], args[1], args[2]) : die(USAGE); break
    case 'seturl': args[0] && args[1] && args[2] ? await cmdSetUrl(args[0], args[1], args[2]) : die(USAGE); break
    case 'setselect': args[0] && args[1] && args[2] ? await cmdSetSelect(args[0], args[1], args[2]) : die(USAGE); break
    case 'setnum': args[0] && args[1] && args[2] ? await cmdSetNum(args[0], args[1], args[2]) : die(USAGE); break
    case 'setpeople': args[0] && args[1] && args[2] ? await cmdSetPeople(args[0], args[1], args[2]) : die(USAGE); break
    case 'icon': args[0] && args[1] ? await cmdIcon(args[0], args[1]) : die(USAGE); break
    case 'whoami': await cmdWhoami(); break
    default: die(USAGE)
  }
} catch (err) {
  die(`${err?.code ?? 'error'}: ${err?.message ?? err}`)
}
