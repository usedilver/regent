# ─────────────────────────────────────────────────────────────────────────────
# .env — SECRETOS y lo que cambia por MÁQUINA. Nada más.
#
# Todo lo que describe el BOARD o el COMPORTAMIENTO (nombres de propiedades,
# salas de chat, intake, repos de GitHub) vive en workflow.json: es config del
# equipo, se versiona y se revisa por PR. Lo genera `pnpm setup`.
#
# NUNCA commitear este archivo con valores. chmod 600.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Notion (secretos + identidad del board de esta instancia) ----
NOTION_TOKEN=""
# Llega solo en el handshake de la suscripción; el server lo guarda automáticamente.
NOTION_VERIFICATION_TOKEN=""
# Los imprime `pnpm setup` (o src/setup-board.ts) al adoptar/crear el board.
DATABASE_ID=""
DATA_SOURCE_ID=""

# ---- Slack (secretos; a quién invitar se configura en workflow.json → chat) ----
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# ---- GitHub (opcional: solo si el webhook llega por túnel en vez de `gh webhook forward`) ----
GITHUB_WEBHOOK_SECRET=""

# ---- Máquina ----
# Carpeta con tus repos clonados. El card elige el suyo con su propiedad Repo
# (se busca en REPO_PATH/<n> y un nivel adentro); si falta, el bridge lo clona.
REPO_PATH="~/Projects"
PORT=8787
HOST="127.0.0.1"
WEBHOOK_PATH="/notion-webhook"
# herdr | tmux | headless — vacío = autodetección (Mac: herdr; EC2: tmux)
TERMINAL_BACKEND=""

# ---- Tuning operativo (opcional; los defaults sirven) ----
# EVENT_FRESHNESS_MINUTES=30    # descarta reintentos viejos de Notion
# QUEUE_MAX_AGE_MINUTES=15      # caducidad de la cola de triggers in-flight
# PR_POLL_MINUTES=2             # respaldo del webhook de GitHub
# EVENTS_LOG_MAX_MB=5           # rotación de log/events.jsonl
