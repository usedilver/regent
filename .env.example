# Regent server credentials. Never commit populated values.
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
# Required only for auth.mode: team.
ANTHROPIC_API_KEY=""
# Optional overrides. Relative paths resolve from the service working directory.
# REGENT_CONFIG=config/regent.yaml
# Keep this filename for existing instances; it is not a source-code version.
# REGENT_DB=log/v2.sqlite
# REGENT_PORT=8788
# Bind address; keep loopback except inside a container that publishes the port.
# REGENT_HOST=127.0.0.1
# REGENT_USER_ID=U_REPLACE
# Personal inbound MCP tokens (at least 32 random characters); never provider credentials.
# REGENT_MCP_TOKEN_DILVER=
# Optional upstream OIDC application credential; never a user's Claude login/token.
# REGENT_MCP_OIDC_CLIENT_SECRET=
# Repository MCP and deployment credentials belong in that repository, not here.
