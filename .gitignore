docs/
!docs/despliegue.md

# estado de instancia (runtime local: logs, salas, colas, worktrees de cards)
log/
tmp/
worktrees/
projects/

# dependencias y sistema
node_modules/
.DS_Store

# settings locales de claude code (permisos de esta máquina)
.claude/settings.local.json
